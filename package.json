{
  "name": "minecraft-3d-viewer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run generate-skins && npm run generate-animations && vite",
    "build": "npm run generate-skins && npm run generate-animations && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "generate-skins": "node scripts/generate-skins-manifest.js",
    "generate-animations": "node scripts/generate-animations-manifest.js",
    "generate-skin-previews": "npm run generate-skins && node scripts/generate-skin-previews.js",
    "set-skin": "node scripts/set-skin.js",
    "set-animation": "node scripts/set-animation.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/three": "^0.165.0",
    "puppeteer": "^24.38.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
